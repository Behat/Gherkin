{
    "name":         "behat/gherkin",
    "description":  "Gherkin DSL parser for PHP",
    "keywords":     ["BDD", "parser", "DSL", "Behat", "Gherkin", "Cucumber"],
    "homepage":     "https://behat.org/",
    "type":         "library",
    "license":      "MIT",
    "authors":      [
        {
            "name":      "Konstantin Kudryashov",
            "email":     "ever.zet@gmail.com",
            "homepage":  "https://everzet.com"
        }
    ],

    "require": {
        "php": ">=8.1 <8.7",
        "composer-runtime-api": "^2.2"
    },

    "require-dev": {
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0",
        "phpunit/phpunit": "^10.5",
        "cucumber/gherkin-monorepo": "dev-gherkin-v43.0.0",
        "cweagans/composer-patches": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.77",
        "phpstan/phpstan": "2.2.14",
        "phpstan/extension-installer": "^1",
        "phpstan/phpstan-phpunit": "^2",
        "mikey179/vfsstream": "1.6.12",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },

    "suggest": {
        "symfony/yaml": "If you want to parse features, represented in YAML files"
    },

    "autoload": {
        "psr-4": {
            "Behat\\Gherkin\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\Behat\\Gherkin\\": "tests/"
        }
    },

    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    },

    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "cucumber/gherkin-monorepo",
                "version": "dev-gherkin-v43.0.0",
                "source": {
                    "type": "git",
                    "url": "https://github.com/cucumber/gherkin.git",
                    "reference": "3d70e2bb4e0f16a568ee539a5ce0b03fb247a777"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/cucumber/gherkin/zipball/3d70e2bb4e0f16a568ee539a5ce0b03fb247a777",
                    "reference": "3d70e2bb4e0f16a568ee539a5ce0b03fb247a777"
                }
            }
        }
    ],

    "scripts": {
        "cs": "php-cs-fixer check --diff --ansi --show-progress=dots --verbose",
        "cs-fix": "php-cs-fixer fix --diff --ansi --show-progress=dots",
        "phpstan": "phpstan analyze --ansi --no-progress --memory-limit=-1",
        "test": [
            "phpunit --colors=always"
        ]
    },

    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "cweagans/composer-patches": true
        }
    }
}
